# Host port the container is exposed on (127.0.0.1 only). Pick a free one
# if other apps on the VPS already use 3000.
APP_PORT=3000

# Gmail SMTP for the contact form (use an App Password, not your real password)
EMAIL_USER=
EMAIL_PASS=

# Optional analytics - baked in at build time, so run `make up` again after changing
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
